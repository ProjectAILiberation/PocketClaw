# 敏感文件 - 绝不提交
.env
secrets/*.key
secrets/*.pem
secrets/*.encrypted
data/credentials/*

# 运行时凭据/状态（由容器在运行时写入 config/workspace，绝不能进仓库或发行包）
config/workspace/.provider
config/workspace/.gateway_token
config/workspace/.host_ip
config/workspace/.bound_providers
data/.build_hash

# 加密前的明文
*.decrypted

# 运行时数据
data/sessions/*
data/logs/*

# Docker相关
openclaw-src/

# 开发备忘 - 不参与分发
开发备忘.md

# 系统文件
.DS_Store
._*
Thumbs.db
desktop.ini
System Volume Information/
.Spotlight-V100/
.fseventsd/

# 保留目录结构的占位文件
!data/credentials/.gitkeep
!data/sessions/.gitkeep
!data/logs/.gitkeep
!secrets/.gitkeep
!config/workspace/skills/.gitkeep
!config/workspace/skills/.gitkeep
